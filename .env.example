# Copy this file to .env and fill in your own values. .env is git-ignored: never commit real keys.
#
# Load it into your shell before starting Jupyter, for example:
#   set -a; source .env; set +a; jupyter lab

# Claude API key for the "Anthropic 1P" notebooks (create one in the Claude Console).
ANTHROPIC_API_KEY=

# Amazon Bedrock notebooks only. Prefer `aws configure` / AWS SSO profiles over raw keys.
# AWS_PROFILE=
# AWS_DEFAULT_REGION=us-east-1
